# Test environment — copied to .env or exported in CI.
# BASE_URL overrides the Playwright webServer base URL (e.g. a deployed preview).
BASE_URL=http://localhost:3200

# Plausible analytics — the site's personalized script URL (plausible.io →
# site settings → Site Installation → the https://plausible.io/js/pa-XXXXX.js
# part). Served first-party via proxy.ts. Unset = analytics fully disabled.
# PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/pa-XXXXX.js

# Slack incoming webhook for pilot registration notifications
# (app/api/registration/route.ts). Unset = registration form reports an error
# on submit.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Test environment — copied to .env or exported in CI.
# BASE_URL overrides the Playwright webServer base URL (e.g. a deployed preview).
BASE_URL=http://localhost:3200

# Plausible analytics — the site's personalized script URL (plausible.io →
# site settings → Site Installation → the https://plausible.io/js/pa-XXXXX.js
# part). Served first-party via proxy.ts. Unset = analytics fully disabled.
# PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/pa-XXXXX.js

# Set true only when the site runs behind a trusted reverse proxy
# (Cloudflare/nginx) that strips and re-creates client-IP headers. Without
# it, proxy.ts does not forward cf-connecting-ip / x-forwarded-for to
# Plausible — a direct client must not be able to forge them.
# PLAUSIBLE_TRUST_PROXY=false

# Slack incoming webhook for pilot registration notifications
# (app/api/registration/route.ts). Unset = registration form reports an error
# on submit.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Test-only webhook capture (app/api/test-webhook/route.ts). Set by Playwright's
# webServer.env during local e2e runs so registration tests deliver to local
# memory instead of the real Slack webhook. NEVER set in production — the route
# 404s unless this is exactly 'true'.
# TEST_WEBHOOK_CAPTURE=true

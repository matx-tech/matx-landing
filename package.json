{
  "name": "matx-landing",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "next dev",
    "build": "next build",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "audit:mobile": "mkdir -p .audits && lighthouse http://localhost:3000 --preset=perf --throttling-method=simulate --throttling.rttMs=150 --throttling.throughputKbps=1638.4 --throttling.uploadThroughputKbps=750 --throttling.cpuSlowdownMultiplier=4 --output-path=.audits/mobile-$(date +%Y%m%d-%H%M%S).report.html --save-assets=false",
    "audit:desktop": "mkdir -p .audits && lighthouse http://localhost:3000 --preset=desktop --output-path=.audits/desktop-$(date +%Y%m%d-%H%M%S).report.html --save-assets=false"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@plausible-analytics/tracker": "^0.4.5",
    "@radix-ui/react-dialog": "^1.1.23",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.30.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@next/bundle-analyzer": "^16.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "lefthook": "^2.1.10",
    "lighthouse": "^13.4.1",
    "npm-check-updates": "^23.0.2",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
